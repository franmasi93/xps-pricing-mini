# F5: lo que NO sube a Cloud Build con `gcloud run deploy --source .` (secretos, documentos privados y locales).
.gcloudignore
.git/
.gitignore
.env
.env.*
!.env.example
.venv/
.pytest_cache/
**/__pycache__/
*.pyc
# E1-B: de docs/ solo sube la plantilla oficial de importación (la lee app/services/importacion_clientes.py).
docs/*
!docs/extensiones/
docs/extensiones/*
!docs/extensiones/importacion/
salidas/
tests/
start.txt
*.pem
*.key
*credentials*.json
*service-account*.json
frontend/image.png

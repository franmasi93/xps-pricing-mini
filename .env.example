# Plantilla de variables de entorno (sección 5.1 del documento rector).
# Copiar como .env y llenar los valores. NUNCA subir .env al repositorio.

# dev / test / prod
APP_ENV=dev

# Cadenas de conexión (psycopg v3), por ejemplo: postgresql+psycopg://USUARIO:CLAVE@127.0.0.1:5432/BASE
DATABASE_URL=
DATABASE_URL_TEST=

# Clave aleatoria de 64 bytes o más
JWT_SECRET=
JWT_EXPIRA_MIN=480

IVA_TASA=15.00
COT_PREFIJO=COT
MONEDA_BASE=USD
# PDF de cotización (F3): chromium (Playwright) o msedge (Edge instalado)
PDF_NAVEGADOR=chromium

# Tencent Cloud SES (subusuario CAM con permiso solo de SES)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Tomada de la consola de Tencent; no se asume
TENCENT_SES_REGION=
SES_FROM=Xpress - Tarifas <pricing@notificaciones.xpress.ec>
SES_REPLY_TO=pricing@xpress.ec
# Opcional: solo si Tencent exige plantilla
SES_TEMPLATE_ID=
# Según el límite confirmado en la consola
SES_MAX_ADJUNTO_MB=

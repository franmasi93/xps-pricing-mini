# Plantilla de variables de entorno (sección 5.1 del documento rector).
# Copiar como .env y llenar los valores. NUNCA subir .env al repositorio.

# dev / test / prod
APP_ENV=dev

# Cadenas de conexión (psycopg v3), por ejemplo: postgresql+psycopg://USUARIO:CLAVE@127.0.0.1:5432/BASE
DATABASE_URL=
DATABASE_URL_TEST=

# Clave aleatoria de 64 bytes o más
JWT_SECRET=
JWT_EXPIRA_MIN=480

IVA_TASA=15.00
COT_PREFIJO=COT
MONEDA_BASE=USD
# PDF de cotización (F3): chromium (Playwright) o msedge (Edge instalado)
PDF_NAVEGADOR=chromium

# F4: llave Fernet que cifra las llaves de Tencent guardadas en la base (config_correo).
# La genera François en su terminal (nunca en el chat):
#   .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin esta llave el sistema arranca igual y el correo queda "No configurado".
# Toda la configuración de Tencent (región, remitente, plantilla, llaves) se administra en la pantalla.
CONFIG_CIFRADO_KEY=valor-de-ejemplo-generado-con-Fernet-generate-key

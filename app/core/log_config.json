{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {"()": "app.core.registro.FormatoJSON"}
  },
  "handlers": {
    "salida": {"class": "logging.StreamHandler", "formatter": "json", "stream": "ext://sys.stdout"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["salida"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["salida"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["salida"], "level": "INFO", "propagate": false},
    "app": {"handlers": ["salida"], "level": "INFO", "propagate": false}
  },
  "root": {"handlers": ["salida"], "level": "WARNING"}
}
